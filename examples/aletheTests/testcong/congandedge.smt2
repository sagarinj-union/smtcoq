(set-logic UFLIA)
(declare-fun a () Bool)
(declare-fun b () Bool)
(declare-fun c () Bool)
(declare-fun d () Bool)
(declare-fun x () Bool)
(declare-fun y () Bool)
(declare-fun z () Bool)
(declare-fun w () Bool)
(declare-fun j () Bool)
(assert (= a x))
(assert (= b y))
(assert (= c z))
(assert (= d w))
(assert (not (= (and a b j c d) (and x y j z w))))
(check-sat)
(exit)
