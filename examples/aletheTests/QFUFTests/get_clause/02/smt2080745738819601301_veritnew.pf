(assume hyp1 circuit)
(assume hyp2 rd2)
(assume hyp3 (not grn))
(assume hyp4 (=> org (and (not rd1) (not rd2))))
(assume hyp5 (=> rd1 (not rd2)))
(assume goal (not (not org)))
(step t7 (cl (not (not (not org))) org) :rule not_not)
(step t8 (cl org) :rule th_resolution :premises (t7 goal))
(step t9 (cl (= (not (not org)) org)) :rule not_simplify)
(step t10 (cl (not (= (not (not org)) org)) (not (not (not org))) org) :rule equiv_pos2)
(step t11 (cl (not (not (not (not org)))) (not org)) :rule not_not)
(step t12 (cl (not (= (not (not org)) org)) (not org) org) :rule th_resolution :premises (t11 t10))
(step t13 (cl true) :rule tautology :premises (t12))
(step t14 (cl org) :rule th_resolution :premises (t8 t9 t13))
(step t15 (cl (not (and (not rd1) (not rd2))) (not rd1)) :rule and_pos)
(step t16 (cl (not (and (not rd1) (not rd2))) (not rd2)) :rule and_pos)
(step t17 (cl (not org) (and (not rd1) (not rd2))) :rule implies :premises (hyp4))
(step t18 (cl (not (and (not rd1) (not rd2)))) :rule resolution :premises (t16 hyp2))
(step t19 (cl (not org)) :rule resolution :premises (t17 t18))
(step t20 (cl (not rd1) (not rd2)) :rule implies :premises (hyp5))
(step t21 (cl (not rd1)) :rule resolution :premises (t20 hyp2))
(step t22 (cl) :rule resolution :premises (t14 t19))
