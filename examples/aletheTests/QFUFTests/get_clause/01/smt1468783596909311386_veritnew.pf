(assume hyp1 (=> rd1 (not rd2)))
(assume hyp2 circuit)
(assume hyp3 rd2)
(assume hyp4 (not grn))
(assume hyp5 (not org))
(assume goal (not (not rd1)))
(step t7 (cl (not (not (not rd1))) rd1) :rule not_not)
(step t8 (cl rd1) :rule th_resolution :premises (t7 goal))
(step t9 (cl (= (not (not rd1)) rd1)) :rule not_simplify)
(step t10 (cl (not (= (not (not rd1)) rd1)) (not (not (not rd1))) rd1) :rule equiv_pos2)
(step t11 (cl (not (not (not (not rd1)))) (not rd1)) :rule not_not)
(step t12 (cl (not (= (not (not rd1)) rd1)) (not rd1) rd1) :rule th_resolution :premises (t11 t10))
(step t13 (cl true) :rule tautology :premises (t12))
(step t14 (cl rd1) :rule th_resolution :premises (t8 t9 t13))
(step t15 (cl (not rd1) (not rd2)) :rule implies :premises (hyp1))
(step t16 (cl) :rule resolution :premises (t15 hyp3 t14))
